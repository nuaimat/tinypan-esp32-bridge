CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# ── Dual-core split (EXPERIMENT) ─────────────────────────────────
# Espressif's RF Coexistence guide explicitly recommends running the
# WiFi stack and the BT controller+host on DIFFERENT CPUs. The stock
# config piled everything on core 0 (BT ctrl 0, Bluedroid 0, WiFi 0,
# main task CPU0) while core 1 idled. Split:
#   core 0 = BT controller + Bluedroid host (+ floating tp_tx/RX tasks)
#   core 1 = WiFi task + lwIP tcpip + app main loop
# Single radio: RF time-slicing/coex arbitration is unchanged; this
# removes CPU contention only. Needs hardware A/B test (EAPOL, ping
# jitter, wedge frequency) before merging to v0.3-dev.
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_L2CAP_ENABLED=y
CONFIG_BT_ACL_CONNECTIONS=4
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=n
# Force BR/EDR (Classic) controller mode only — saves IRAM
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CONTROLLER_MODE_BR_EDR_ONLY=y
# Disable BLE to save flash/IRAM
CONFIG_BT_BLE_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# Disable BT controller modem sleep to reduce sniff mode transitions
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
# AMPDU aggregation window: reduced from 16 to 8 to free heap for BT stack
CONFIG_ESP_WIFI_TX_BA_WIN=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# Reduce WiFi dynamic buffers to free heap for BT/BNEP L2CAP buffers.
# ponytail: 16 RX + 16 TX pins ~50 KB heap (each pbuf ~1.6 KB); under a
# Mac's AMPDU-aggregated (winSize=64) forwarding storm this exhausted heap
# (min free hit 964 bytes) → GAP_ConnWriteData malloc(size=2048) failed →
# L2CAP write timeouts → DNS ENOMEM. 8+8 halves that to ~25 KB, the precise
# margin the BT stack needs to keep a GAP TX buffer in flight.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# IRAM headroom: BT Classic controller + Bluedroid + WiFi + coex overflow
# iram0_0_seg by 1144 bytes on a clean ESP-IDF v5.5 build with the WiFi
# IRAM optimizations enabled (the repo did not link for new builders).
# The bridge is bottlenecked by the BT PAN radio (~300-700 kbps), not
# WiFi, so move WiFi code to flash (cached) and FreeRTOS functions to
# flash. Trade-off: WiFi pauses briefly during NVS/SPIFFS writes (rare,
# config saves only). IRAM usage drops to ~71%.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
# SPIFFS
CONFIG_SPIFFS_CACHE=y
CONFIG_SPIFFS_CACHE_WR=y
CONFIG_SPIFFS_PAGE_CHECK=y
CONFIG_SPIFFS_MAX_PARTITIONS=3
CONFIG_SPIFFS_USE_MTIME=y
# Flash size: 4MB (needed to fit 2MB factory + 2MB www partitions)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
